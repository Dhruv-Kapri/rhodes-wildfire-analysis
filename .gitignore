# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.python-version.local

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Data (fetched via Figshare + STAC; see data/README.md) ---
# These are large (>1 GB total) and must not be committed to git.
/data/*
!/data/README.md

# --- Generated outputs (regenerated by running the notebooks) ---
/outputs/*
!/outputs/README.md
# Safety net for rasters accidentally written next to the notebooks
notebooks/*.tif
notebooks/*.tiff

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/
*.swp
